# ============================================================
# Enterprise Compliance AI Platform — Environment Configuration
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME="Enterprise Compliance AI Platform"
ENVIRONMENT=development
DEBUG=false

# ---- API ----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://autonomous-compliance-audit-platfor.vercel.app

# ---- Database (Supabase PostgreSQL) ----
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ---- Authentication ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Admin Bootstrap (first run only) ----
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!

# ---- LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Qdrant Cloud ----
QDRANT_URL=https://e5532072-3c61-40b7-8976-b0aff377b734.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
CHROMA_COLLECTION_NAME=documents

# ---- File Storage ----
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="compliance_documents"
MAX_UPLOAD_SIZE_MB=50

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- MCP: Local Files ----
MCP_LOCAL_FILES_DIR=./mcp_documents

# ---- MCP: Google Drive ----
# Set path to service account JSON file
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ---- MCP: Notion ----
NOTION_API_TOKEN=
NOTION_DATABASE_ID=
